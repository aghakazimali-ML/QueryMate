# Copy this file to .env and fill in at least one key.
# Default provider: "gemini" (free tier) or "openai"
LLM_PROVIDER=gemini

GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Pipeline tuning
LLM_TEMPERATURE=0
MAX_ROWS=500
QUERY_TIMEOUT_SECONDS=15
MAX_FIX_RETRIES=2
TABLE_SELECTION_THRESHOLD=8

# API
# Comma-separated browser origins allowed to call the API (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=50
SESSION_TTL_MINUTES=120
